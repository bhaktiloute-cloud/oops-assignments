#include<iostream>
using namespace std;

template<typename T>
void mySwap(T &a,T &b)
{
  T temp=a;
  a=b;
  b=temp;
}

int main()
{
 
  int emp1=101,emp2=102;
  mySwap(emp1,emp2);

  cout<<"emplyoee ids after swap:"<<emp1<<""<<emp2<<endl;

  int room1=201,room2=202;
  mySwap(room1,room2);

  cout<<"room numbers after swap:"<<room1<<""<<room2<<endl;

  float p1=1.2,p2=2.5;
  mySwap(p1,p2);

  cout<<"task priorities after swap:"<<p1<<""<<p2<<endl;

  return 0;
}
