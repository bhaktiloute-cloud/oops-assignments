#include <iostream>
#include <string>

using namespace std;

class Employee
{
private:
    int id;
    string name;
    string department;
    double salary;

public:
    void setDetails(int empId, string empName, string empDept, double empSal)
    {
        id = empId;
        name = empName;
        department = empDept;
        salary = empSal;
    }

    void displayInfo(bool authorized) const
    {
        if (authorized)
        {
            cout << "ID: " << id << "\n"
                 << "Name: " << name << "\n"
                 << "Department: " << department << "\n"
                 << "Salary: $" << salary << "\n"
                 << "--------------------\n";
        }
        else
        {
            cout << "Access Denied: You are not authorized to view this record.\n";
        }
    }
};

int main()
{
    int numEmployees;

    cout << "Enter number of employees: ";
    cin >> numEmployees;

    
    Employee* staffList = new Employee[numEmployees]; 

    for (int i = 0; i < numEmployees; i++)
    {
        int id;
        string name, department;
        double salary;

        cout << "\nEnter details for Employee " << i + 1 << ":\n";

        cout << "Enter ID: ";
        cin >> id;

        cin.ignore(); // Correctly clears the newline buffer

        cout << "Enter Name: ";
        getline(cin, name);

        cout << "Enter Department: ";
        getline(cin, department);

        cout << "Enter Salary: ";
        cin >> salary;

        staffList[i].setDetails(id, name, department, salary);
    }

    bool isAuthorizedHR;

    cout << "\nAre you authorized to view employee records? (1 = Yes, 0 = No): ";
    cin >> isAuthorizedHR;

    cout << "\n--- Employee Records ---\n";

    if (!isAuthorizedHR) 
    {
        cout << "Access Denied: You are not authorized to view these records.\n";
    } 
    else 
    {
        for (int i = 0; i < numEmployees; i++)
        {
            staffList[i].displayInfo(isAuthorizedHR);
        }
    }

    // Free the dynamically allocated memory to prevent memory leaks
    delete[] staffList; 

    return 0;
